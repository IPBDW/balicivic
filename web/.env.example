# Konfigurasi frontend BaliCivic AI
# Salin file ini menjadi `.env.local` lalu sesuaikan.
#
# NEXT_PUBLIC_API_BASE
#   URL backend FastAPI.
#   - Di-set, mis. http://127.0.0.1:8000  -> pakai backend FastAPI beneran.
#   - Kosong / tidak di-set                -> pakai Next.js API routes (DUMMY),
#                                             HANYA untuk development/demo.
#
# PENTING: di produksi (NODE_ENV=production) dummy routes DITOLAK dengan 503
# kecuali kamu sengaja set NEXT_PUBLIC_ALLOW_DUMMY=true. Ini supaya dashboard
# tidak pernah diam-diam menampilkan data fiktif.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# NEXT_PUBLIC_ALLOW_DUMMY
#   Set "true" hanya kalau kamu memang mau menjalankan build produksi dengan
#   data dummy (mis. demo offline). Jangan dipakai untuk sistem sungguhan.
# NEXT_PUBLIC_ALLOW_DUMMY=true
