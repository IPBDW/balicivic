# ============================================================
# BaliCivic AI — Template Environment Variables
# Copy file ini jadi `.env` lalu isi nilainya:
#   cp .env.example .env
# JANGAN commit file `.env` ke git (sudah ada di .gitignore).
# ============================================================

# --- Keamanan Admin ---
# Token untuk akses panel admin (update status laporan).
# WAJIB diganti sebelum produksi. Bikin yang panjang & acak, contoh:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=ganti_dengan_token_acak_yang_panjang

# URL frontend (dipakai buat link di email alert). Tanpa trailing slash.
FRONTEND_BASE_URL=https://balicivicai.site

# CORS: daftar origin yang boleh akses API, dipisah koma.
# JANGAN pakai "*" di produksi. Isi domain resmi frontend.
CORS_ORIGINS=https://balicivicai.site,https://www.balicivicai.site

# --- Database ---
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/NAMA_DB
# Untuk pengembangan lokal boleh pakai SQLite:
#   sqlite:///data/balicivilai.db
DATABASE_URL=postgresql+psycopg://balicivic:balicivic_dev@localhost:5432/balicivic

# --- LLM (OpenAI-compatible: NineRouter, OpenRouter, DeepSeek, OpenAI, Ollama, dll) ---
# Format utama:
LLM_API_KEY=
LLM_ENDPOINT=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Alias simpel (juga didukung penuh):
# API_KEY=your_key
# ENDPOINT=https://api.ninerouter.com/v1
# NAME_MODEL=your_model_name

# --- Reverse Geocoding (LocationIQ) ---
# Opsional. Kalau kosong, sistem otomatis fallback ke Nominatim (gratis).
# Tanpa salah satu pun, kecamatan/kabupaten tidak terisi dan halaman detail
# hanya menampilkan koordinat.
LOCATIONIQ_API_KEY=

# --- Tuning Deteksi YOLO (opsional, ada default yang aman) ---
# Resolusi inferensi. Foto warga biasanya besar; 640 membuat lubang yang jelas
# terlihat cuma dapat confidence 0.05-0.1. 1024 = titik seimbang akurasi/CPU.
YOLO_IMGSZ=1024
# Batas bawah kandidat yang dikumpulkan sebelum disaring per kelas.
YOLO_CONF_FLOOR=0.10
# Kandidat lemah (di bawah threshold kelas) di atas nilai ini membuat laporan
# ditandai "perlu verifikasi" alih-alih langsung "tidak ditemukan kerusakan".
YOLO_LOW_CONF_MIN=0.02
# Threshold per kelas. Turunkan kalau model sering meleset, naikkan kalau
# terlalu banyak false positive.
CONF_JALAN_BOLONG=0.30
CONF_GENANGAN_AIR=0.30
CONF_SAMPAH_LIAR=0.30
CONF_KABEL_SEMRAWUT=0.045

# Filter batas posisi vertikal (0=atas/langit, 1=bawah/tanah)
# Objek yang berada di zona langit teratas (< 0.18) dibuang agar tidak false positive.
MAX_Y_CENTER_FOR_ROAD=0.18
MAX_Y_CENTER_FOR_WATER=0.18
MAX_Y_CENTER_FOR_GARBAGE=0.20
MIN_Y_CENTER_FOR_CABLE=0.90

# --- Scene Guard ---
# Tolak foto yang jelas bukan infrastruktur jalan (meja kerja, laptop, tas,
# kursi) memakai model konteks COCO. 1 = aktif, 0 = mati.
SCENE_GUARD_ENABLED=1
# Confidence minimum objek indoor agar foto dianggap bukan jalan.
SCENE_GUARD_CONF=0.45
# Luas minimum objek indoor terhadap frame (0.08 = 8%) agar dianggap bukti kuat.
SCENE_GUARD_AREA=0.08

# --- VLM sebagai HAKIM (verifikasi visual) ---
# YOLO tetap jadi sensor: bbox presisi, jumlah objek, skor dasar. Deterministik
# dan tetap jalan offline. VLM dikirimi FOTO + ringkasan output YOLO, lalu:
#   1) memverifikasi apakah YOLO benar (cocok / yolo_salah / yolo_kurang_lengkap)
#   2) menentukan BAND keparahan (RINGAN/SEDANG/BERAT/KRITIS) — bukan angka
#   3) menulis narasi publik & rekomendasi dinas sekaligus
# Skor final dikonversi backend lewat tabel tetap (BAND_SCORE_RANGE), jadi
# tidak ikut "lotre" seperti angka mentah dari model generatif.
# 1 = aktif, 0 = mati (kalau mati, pipeline kembali ke jalur LLM teks lama).
VLM_ENABLED=1
# Sisi terpanjang gambar yang dikirim ke VLM (px). 1024 cukup untuk konteks
# makro tanpa membengkakkan token.
VLM_MAX_IMAGE_DIM=1024
# Kualitas JPEG untuk gambar yang dikirim ke VLM.
VLM_JPEG_QUALITY=85
# Model VLM WAJIB multimodal (bisa menerima image_url). Kalau model teks-only,
# verifikasi visual gagal dan sistem otomatis fallback ke jalur LLM teks.
# Contoh: cbai/deepseek-v4.1-flash, ag/gemini-3.8-flash-high
# LLM_MODEL / NAME_MODEL di atas dipakai bersama oleh VLM dan fallback teks.

# --- Email Alert (SMTP Gmail) ---
# Pakai Gmail App Password, bukan password akun utama.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER_EMAIL=
SMTP_APP_PASSWORD=
ALERT_TARGET_EMAIL=
# Batas minimal skor untuk kirim email (0 = semua laporan kerusakan & verifikasi dikirim)
MIN_EMAIL_SCORE=0
